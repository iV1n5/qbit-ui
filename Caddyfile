# Production server, inside the Docker image: serves the built UI and forwards
# /api/ to qBittorrent on the same origin, like the Vite dev proxy does.
# QBT_URL (no trailing slash) comes from compose.yaml.
#
# The site address has no hostname: plain http, no automatic HTTPS.
:80 {
	root * /srv
	encode zstd gzip

	handle /api/* {
		# Rewriting Origin (below) blinds qBittorrent's CSRF check, so do the
		# check here: refuse requests sent by pages of another origin.
		@crossOrigin {
			header Origin *
			not header Origin http://{hostport}
		}
		respond @crossOrigin "Cross-origin request blocked" 401

		reverse_proxy {$QBT_URL} {
			# qBittorrent answers 401 unless Host carries its own port and,
			# for its CSRF check, Origin and Referer (when sent) match Host.
			header_up Host {upstream_hostport}
			header_up Origin .+ {$QBT_URL}
			header_up Referer .+ {$QBT_URL}/
			# With "reverse proxy support" enabled, qBittorrent would compare
			# Origin with X-Forwarded-Host instead of Host.
			header_up -X-Forwarded-Host
		}
	}

	# Vite puts a content hash in these file names: cache them for good.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html and the rest: always revalidate, so a new deploy shows up.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
